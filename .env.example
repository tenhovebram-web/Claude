# =============================================================================
# SMB-Automation-Hub — Umgebungsvariablen
# Kopiere diese Datei nach .env.local und fülle die Werte aus.
# .env.local wird NICHT committet (siehe .gitignore).
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase (Projekt in Region EU/Frankfurt anlegen — DSGVO!)
# Dashboard -> Project Settings -> API
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR-ANON-OR-PUBLISHABLE-KEY"

# Nur serverseitig verwenden (Cron/Edge-Funktionen, Admin-Tasks).
# NIEMALS an den Client ausliefern.
SUPABASE_SERVICE_ROLE_KEY="YOUR-SERVICE-ROLE-KEY"

# -----------------------------------------------------------------------------
# Demo-/Offline-Modus
# Wenn die Supabase-Variablen oben NICHT gesetzt sind, läuft die App
# automatisch im DEMO_MODE mit Fixture-Daten (ideal für Sales-Demos).
# Optional erzwingen:
# DEMO_MODE="true"
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# Integrationen (Adapter-Schicht). Pro Workspace werden die konkreten
# Provider + Secrets in der DB-Tabelle `integrations.config` (jsonb) abgelegt.
# Globale Fallback-/Provider-Keys können hier stehen:
# -----------------------------------------------------------------------------
# Telefonie/CTI (z. B. Placetel, sipgate, 3CX-Webhook)
# TELEPHONY_WEBHOOK_SECRET=""

# Messaging (E-Mail/SMS-Erinnerungen)
# MESSAGING_PROVIDER="" # z. B. "twilio", "messagebird", "smtp"
# MESSAGING_API_KEY=""
